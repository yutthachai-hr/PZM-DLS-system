# ---- Database ----
# Local: run `npm run db:start` and copy the TCP URL it prints (port may differ)
DATABASE_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable&connection_limit=1&pgbouncer=true"
# Direct (non-pooled) URL used by migrations. On Neon use the non-pooled host; locally same as DATABASE_URL
DIRECT_URL="postgres://postgres:postgres@localhost:51214/template1?sslmode=disable&connection_limit=1"

# ---- Auth ----
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET="change-me"
# Only if serving production over plain http (e.g. shop LAN without TLS)
# COOKIE_SECURE="false"

# ---- Seed ----
# Starter password for admin / manager.* / staff.* accounts (8+ chars). Change after first login.
SEED_PASSWORD="change-me-please"

# ---- LINE Login (optional — without it only username/password login is shown) ----
# LINE Developers → Provider → Create a "LINE Login" channel → Basic settings
LINE_CHANNEL_ID=""
LINE_CHANNEL_SECRET=""
# Public URL of the app; callback = <APP_URL>/api/auth/line/callback (register it in the channel)
# Leave empty to use the request's own origin
APP_URL=""
